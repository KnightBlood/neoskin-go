APP_NAME=NeoSkin
APP_ENV=local
# Goravel 要求 32 个可打印字符（与 PHP 的 base64: 二进制 key 不同）
APP_KEY=
APP_DEBUG=true

APP_URL=http://127.0.0.1:3000
APP_HOST=127.0.0.1
APP_PORT=3000
# 请求超时（秒）；在线更新探测更新源需要 > 8s
HTTP_REQUEST_TIMEOUT=30

# 站点版本与更新源（对应 PHP config/app.php）
APP_VERSION=6.0.11_patch
UPDATE_SOURCE=https://skin.blessing.dreamcraft.eu.org/update.json

# 邮件（找回密码/邮箱验证）；留空则发送时直接报错
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=NeoSkin

# sqlite / mysql / mariadb / pgsql / sqlsrv
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# 可选：优先级高于 DB_*
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/blessing_skin

# SQL Server（本地 WiltonDB）
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# 本机开发数据库（tools/scripts/db.cmd）
# mysql:   DB_PORT=3307  DB_USERNAME=blessing DB_PASSWORD=123456 DB_DATABASE=blessing_skin
# mariadb: DB_PORT=3308  DB_USERNAME=blessing DB_PASSWORD=123456 DB_DATABASE=blessing_skin
# pgsql:   DB_PORT=5433  DB_USERNAME=postgres DB_PASSWORD=123456 DB_DATABASE=blessing_skin
# sqlsrv:  DB_PORT=1433  DB_USERNAME=wilton   DB_PASSWORD=123456 DB_DATABASE=blessing_skin
#          DB_ENCRYPT=false DB_TRUST_SERVER_CERTIFICATE=true

NEOSKIN_STORAGE_ROOT=storage
# PHP 站点 APP_KEY（含 base64: 前缀），用于 Laravel 签名 URL 与 laravel_token。
NEOSKIN_APP_KEY=
