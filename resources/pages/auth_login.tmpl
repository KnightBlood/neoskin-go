{{define "auth_login"}}{{template "auth-open" .}}
        <main></main>
        {{if .Error}}<div class="alert alert-warning">{{.Error}}</div>{{end}}
        <p class="login-box-msg">{{t "auth.login.message"}}</p>
        <div class="mt-3">
          <a href="/auth/register">{{t "auth.register-link"}}</a>
        </div>
{{template "auth-close" .}}{{end}}
