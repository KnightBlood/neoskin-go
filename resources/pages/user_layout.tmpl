{{define "user-header"}}
    <nav class="main-header navbar navbar-expand navbar-{{.NavbarColor}} navbar-{{.ColorMode}}">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" data-widget="pushmenu" href="#">
            <i class="fas fa-bars"></i>
          </a>
        </li>
      </ul>

      <ul class="navbar-nav ml-auto">
        {{if .DarkMode}}
          <li class="nav-item" id="toggle-dark-mode">
            <a class="nav-link" href="#" role="button"><i class="fas fa-moon"></i></a>
          </li>
        {{else}}
          <li class="nav-item" id="toggle-dark-mode">
            <a class="nav-link" href="#" role="button"><i class="fas fa-sun"></i></a>
          </li>
        {{end}}
        {{template "languages" .}}
        {{template "user-menu" .}}
      </ul>
    </nav>
{{end}}

{{define "user-panel"}}
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
          <div class="image">
            <picture>
              <source srcset="{{.AvatarURL}}" type="image/png">
              <img src="{{.AvatarPNGURL}}" class="img-circle elevation-2" alt="User Image">
            </picture>
          </div>
          <div class="info">
            <a href="/user/profile" class="d-block" data-mark="nickname">{{.Nickname}}</a>
            {{if .IsAdmin}}<span class="badge badge-primary">STAFF</span>{{end}}
          </div>
        </div>
{{end}}

{{define "side-menu"}}
  {{range .}}
    {{if .Children}}
      <li class="nav-item {{if .Active}}active menu-open{{end}}">
        <a href="#" class="nav-link">
          <i class="nav-icon fas {{.Icon}}"></i>
          <p>{{.Title}}<i class="right fas fa-angle-left"></i></p>
        </a>
        <ul class="nav nav-treeview">
          {{template "side-menu" .Children}}
        </ul>
      </li>
    {{else}}
      <li class="nav-item {{if .Active}}active{{end}}">
        <a href="{{.Link}}" class="nav-link">
          <i class="nav-icon fas {{.Icon}}"></i>
          <p>{{.Title}}</p>
        </a>
      </li>
    {{end}}
  {{end}}
{{end}}

{{define "user-sidebar"}}
    <aside class="main-sidebar sidebar-{{.SidebarColor}} elevation-3">
      <a href="/" class="brand-link text-center">
        <span class="brand-text font-weight-light">{{.SiteName}}</span>
      </a>
      <div class="sidebar">
        {{template "user-panel" .}}
        <nav class="mt-2">
          <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu">
            <li class="nav-header">{{t "general.user-center"}}</li>
            {{template "side-menu" .MenuItems}}
            <li class="nav-header">{{t "general.explore"}}</li>
            {{template "side-menu" .ExploreItems}}
            {{if .IsAdmin}}
              <li class="nav-header">{{t "general.manage"}}</li>
              <li class="nav-item">
                <a class="nav-link" href="/admin">
                  <i class="nav-icon fas fa-cog"></i>
                  <p>{{t "general.admin-panel"}}</p>
                </a>
              </li>
            {{end}}
          </ul>
        </nav>
      </div>
    </aside>
{{end}}

{{define "user-open"}}<!DOCTYPE html>
<html lang="{{.Locale}}">
  <head>
    {{template "head" .}}
    <title>{{.Title}} - {{.SiteName}}</title>
  </head>

  <body class="{{if .DarkMode}}dark-mode {{end}}hold-transition sidebar-mini">
    <div class="wrapper">
      {{template "user-header" .}}
      {{template "user-sidebar" .}}
      <div class="content-wrapper">
        <div class="content-header">
          <div class="container-fluid">
            <div class="d-flex justify-content-between flex-wrap">
              <div>
                <h1 class="m-0">{{.Title}}</h1>
              </div>
              <div>
                <div class="breadcrumb"></div>
              </div>
            </div>
          </div>
        </div>
        <section class="content">
          <div class="container-fluid">
{{end}}

{{define "user-close"}}
          </div>
        </section>
      </div>
      <footer class="main-footer">
        {{template "copyright" .}}
      </footer>
    </div>
    {{template "foot" .}}
  </body>
</html>
{{end}}

{{define "admin-sidebar"}}
    <aside class="main-sidebar sidebar-{{.SidebarColor}} elevation-3">
      <a href="/" class="brand-link text-center">
        <span class="brand-text font-weight-light">{{.SiteName}}</span>
      </a>
      <div class="sidebar">
        {{template "user-panel" .}}
        <nav class="mt-2">
          <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu">
            <li class="nav-header">{{t "general.admin-panel"}}</li>
            {{template "side-menu" .MenuItems}}
            <li class="nav-header">{{t "general.back"}}</li>
            <li class="nav-item">
              <a class="nav-link" href="/user">
                <i class="nav-icon fas fa-user"></i>
                <p>{{t "general.user-center"}}</p>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/skinlib">
                <i class="nav-icon fas fa-archive"></i>
                <p>{{t "general.skinlib"}}</p>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </aside>
{{end}}

{{define "admin-open"}}<!DOCTYPE html>
<html lang="{{.Locale}}">
  <head>
    {{template "head" .}}
    <title>{{.Title}} - {{.SiteName}}</title>
  </head>
  <body class="{{if .DarkMode}}dark-mode {{end}}hold-transition sidebar-mini">
    <div class="wrapper">
      {{template "user-header" .}}
      {{template "admin-sidebar" .}}
      <div class="content-wrapper">
        <div class="content-header">
          <div class="container-fluid">
            <div class="d-flex justify-content-between flex-wrap">
              <div><h1 class="m-0">{{.Title}}</h1></div>
              <div><div class="breadcrumb"></div></div>
            </div>
          </div>
        </div>
        <section class="content">
          <div class="container-fluid">
{{end}}

{{define "admin-close"}}
          </div>
        </section>
      </div>
      <footer class="main-footer">{{template "copyright" .}}</footer>
    </div>
    <script id="blessing-extra" type="application/json">{{.ExtraJSON}}</script>
    {{template "foot" .}}
  </body>
</html>
{{end}}