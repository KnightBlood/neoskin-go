{{define "skinlib-open"}}<!DOCTYPE html>
<html lang="{{.Locale}}">
  <head>
    {{template "head" .}}
    <title>{{.Title}} - {{.SiteName}}</title>
  </head>

  <body class="hold-transition layout-top-nav">
    <div class="wrapper">
      <nav class="main-header navbar navbar-expand navbar-{{.NavbarColor}} navbar-{{.ColorMode}} ml-0">
        <div class="container">
          <div class="navbar-header">
            <a href="/" class="navbar-brand">{{.SiteName}}</a>
          </div>

          <div class="collapse navbar-collapse">
            <ul class="nav navbar-nav">
              <li class="nav-item active">
                <a class="nav-link" href="/skinlib">{{t "general.skinlib"}}</a>
              </li>
              {{if .LoggedIn}}
                <li class="nav-item">
                  <a class="nav-link" href="/user/closet">{{t "general.my-closet"}}</a>
                </li>
              {{end}}
            </ul>
          </div>

          <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
              {{if .LoggedIn}}
                <li class="nav-item">
                  <a class="nav-link" href="/skinlib/upload">
                    <i class="fas fa-upload" aria-hidden="true"></i>&nbsp;
                    <span class="d-none d-sm-inline">{{t "skinlib.general.upload-new-skin"}}</span>
                  </a>
                </li>
              {{end}}
              {{template "languages" .}}
              {{if .LoggedIn}}
                {{template "user-menu" .}}
              {{else}}
                <li class="nav-item">
                  <a class="nav-link" href="/auth/login">
                    <i class="fas fa-user"></i>
                    <span class="d-none d-sm-inline">{{t "general.anonymous"}}</span>
                  </a>
                </li>
              {{end}}
            </ul>
          </div>
        </div>
      </nav>
{{end}}

{{define "skinlib-close"}}
      <footer class="main-footer">
        <div class="container">
          {{template "copyright" .}}
        </div>
      </footer>
    </div>
    <script id="blessing-extra" type="application/json">{{.ExtraJSON}}</script>
    {{template "foot" .}}
  </body>
</html>
{{end}}
