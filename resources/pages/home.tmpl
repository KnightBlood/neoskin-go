{{define "home"}}<!DOCTYPE html>
<html lang="{{.Locale}}">
  <head>
    {{template "head" .}}
    <link rel="preload" as="image" href="{{.HomePicURL}}">
    <title>{{.SiteName}}</title>
    <style>
      .hp-wrapper {
        {{if .FixedBG}}background-color: rgba(0, 0, 0, 0);{{else}}background-image: url('{{.HomePicURL}}');{{end}}
      }
    </style>
    <link href="{{.HomeCSS}}" rel="stylesheet" crossorigin="anonymous">
  </head>

  <body class="hold-transition layout-top-nav">
    <div class="hp-wrapper">
      {{if .FixedBG}}
        <div id="fixed-bg" style="background-image: url('{{.HomePicURL}}')"></div>
      {{end}}

      <nav class="navbar navbar-expand fixed-top navbar-{{.NavbarColor}} navbar-{{.ColorMode}} ml-0 {{if .TransparentNavbar}}transparent{{end}}">
        <div class="container">
          <div class="navbar-header">
            <a href="/" class="navbar-brand">{{.SiteName}}</a>
          </div>

          <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
              <li class="nav-item">
                <a class="nav-link" href="/skinlib">{{t "general.skinlib"}}</a>
              </li>

              {{template "languages" .}}

              {{if .LoggedIn}}
                {{template "user-menu" .}}
              {{else}}
                <li class="nav-item">
                  <a class="nav-link" href="/auth/login">
                    <i class="icon fas fa-sign-in-alt"></i>
                    {{t "general.login"}}
                  </a>
                </li>
              {{end}}
            </ul>
          </div>
        </div>
      </nav>

      <div class="container">
        <div class="splash">
          <h1 class="splash-head">{{.SiteName}}</h1>
          <p class="splash-subhead">{{.SiteDescription}}</p>
          <p>
            {{if .LoggedIn}}
              <a href="/user" class="main-button">{{t "general.user-center"}}</a>
            {{else}}
              <a href="/auth/register" class="main-button">{{t "general.register"}}</a>
            {{end}}
          </p>
        </div>
      </div>

      {{if .HideIntro}}
        <div id="copyright" class="without-intro">
          <div class="container">
            {{template "copyright" .}}
          </div>
        </div>
      {{end}}
    </div>

    {{if not .HideIntro}}
      <div id="intro">
        <div class="container">
          <div class="text-center">
            <h1>{{t "index.features.title"}}</h1>
            <br>
            <br>
            <div class="container-lg">
              <div class="row">
                <div class="col-lg">
                  <i class="fas {{t "index.features.first.icon"}} mb-3" aria-hidden="true"></i>
                  <h3>{{t "index.features.first.name"}}</h3>
                  <p>{{t "index.features.first.desc"}}</p>
                </div>
                <div class="col-lg">
                  <i class="fas {{t "index.features.second.icon"}} mb-3" aria-hidden="true"></i>
                  <h3>{{t "index.features.second.name"}}</h3>
                  <p>{{t "index.features.second.desc"}}</p>
                </div>
                <div class="col-lg">
                  <i class="fas {{t "index.features.third.icon"}} mb-3" aria-hidden="true"></i>
                  <h3>{{t "index.features.third.name"}}</h3>
                  <p>{{t "index.features.third.desc"}}</p>
                </div>
              </div>
            </div>
          </div>
          <br>
        </div>
      </div>
      <div id="footer-wrap">
        <div class="container">
          <div class="row">
            <div class="col-lg-6 mb-2">
              {{t "index.introduction" "sitename" .SiteName}}
            </div>
            <div class="col-lg-4"></div>
            <div class="col-lg-2 d-flex justify-content-center align-items-center">
              <a href="/auth/register" class="main-button">{{t "index.start"}}</a>
            </div>
          </div>
        </div>
      </div>
      <div id="copyright" class="with-intro">
        <div class="container">
          {{template "copyright" .}}
        </div>
      </div>
    {{end}}

    <script type="application/json" id="blessing-extra">{{.ExtraJSON}}</script>
    {{template "foot" .}}
  </body>
</html>
{{end}}
