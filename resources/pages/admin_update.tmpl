{{define "admin_update"}}{{template "admin-open" .}}
          {{if .UpdateNotice}}<div class="alert alert-success" role="status">{{.UpdateNotice}}</div>{{end}}
          {{if .UpdateError}}<div class="alert alert-danger" role="alert">{{.UpdateError}}</div>{{end}}
          <div class="row">
            <div class="col-md-6">
              <div class="card card-primary">
                <div class="card-header">
                  <h3 class="card-title">{{t "admin.update.info.title"}}</h3>
                </div>
                <div class="card-body">
                  {{if .CanUpdate}}
                    <div class="callout callout-info">{{t "admin.update.info.available"}}</div>
                    <div class="container-fluid">
                      <div class="row mb-3">
                        <div class="col-sm-4">{{t "admin.update.info.versions.latest"}}</div>
                        <div class="col-sm-8">v{{.LatestVersion}}</div>
                      </div>
                      <div class="row mt-3">
                        <div class="col-sm-4">{{t "admin.update.info.versions.current"}}</div>
                        <div class="col-sm-8">v{{.CurrentVersion}}</div>
                      </div>
                    </div>
                  {{else}}
                    <div class="callout callout-success">{{t "admin.update.info.up-to-date"}}</div>
                    <div class="container-fluid">
                      <div class="row">
                        <div class="col-sm-4">{{t "admin.update.info.versions.current"}}</div>
                        <div class="col-sm-8">v{{.CurrentVersion}}</div>
                      </div>
                    </div>
                  {{end}}
                </div>
                <div class="card-footer">
                  <button class="btn bg-primary" id="update" {{if not .CanUpdate}}disabled="disabled"{{end}}>{{t "admin.update.info.button"}}</button>
                  <a target="_blank" class="btn btn-default float-right"
                     href="https://github.com/DreamCraft-Tech/blessing-skin-server-patch/releases">{{t "admin.update.info.check-github"}}</a>
                </div>
              </div>

              <div class="card card-outline card-primary">
                <div class="card-header"><h3 class="card-title">ZIP 运行包更新</h3></div>
                <div class="card-body">
                  <p>上传完整的 Blessing Skin 运行包，校验后安装。支持直接包含程序文件，或外层包含一个目录的 ZIP。</p>
                  <p class="text-muted">运行包包含 <code>vendor/</code> 和编译后的前端资源。应用上传上限：<strong>{{.UploadLimit}}</strong>。</p>
                  <form method="post" action="/admin/update/upload" enctype="multipart/form-data" data-system-update-form data-progress="正在上传并校验运行包…">
                    <input type="hidden" name="_token" value="{{.CSRF}}">
                    <div class="form-group">
                      <label for="system-update-package">选择 ZIP 运行包</label>
                      <div class="custom-file">
                        <input id="system-update-package" class="custom-file-input" type="file" name="package" accept=".zip,application/zip" required>
                        <label class="custom-file-label" for="system-update-package" data-browse="选择文件">尚未选择文件</label>
                      </div>
                    </div>
                    <button type="submit" class="btn btn-primary">上传并校验</button>
                    <p class="mt-2 mb-0" role="status" data-update-progress hidden></p>
                  </form>
                  {{if .HasPackage}}
                    <hr>
                    <dl class="row">
                      <dt class="col-sm-4">目标版本</dt><dd class="col-sm-8">{{.PackageVersion}}</dd>
                      <dt class="col-sm-4">程序文件</dt><dd class="col-sm-8">{{.PackageCount}} 个</dd>
                      <dt class="col-sm-4">SHA-256</dt><dd class="col-sm-8"><code style="overflow-wrap:anywhere">{{.PackageSHA}}</code></dd>
                    </dl>
                    <form method="post" action="/admin/update/install" data-system-update-form data-progress="正在安装运行包…">
                      <input type="hidden" name="_token" value="{{.CSRF}}">
                      <input type="hidden" name="id" value="{{.PackageID}}">
                      <button type="submit" class="btn btn-success">确认安装 {{.PackageVersion}}</button>
                      <p class="mt-2 mb-0" role="status" data-update-progress hidden></p>
                    </form>
                  {{end}}
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card card-info">
                <div class="card-header"><h3 class="card-title">{{t "admin.update.cautions.title"}}</h3></div>
                <div class="card-body">
                  {{t "admin.update.cautions.text"}}
                  <a target="_blank" href="https://blessing.netlify.com/update-sources.html">{{t "admin.update.cautions.link"}}</a>
                </div>
              </div>
            </div>
          </div>

          <script>
            var packageInput = document.getElementById('system-update-package');
            if (packageInput) {
              packageInput.addEventListener('change', function () {
                packageInput.nextElementSibling.textContent = packageInput.files.length ? packageInput.files[0].name : '尚未选择文件';
              });
            }
            document.querySelectorAll('[data-system-update-form]').forEach(function (form) {
              form.addEventListener('submit', function () {
                form.querySelector('button[type="submit"]').disabled = true;
                var status = form.querySelector('[data-update-progress]');
                status.hidden = false;
                var spinner = document.createElement('i');
                spinner.className = 'fas fa-spinner fa-spin mr-1';
                spinner.setAttribute('aria-hidden', 'true');
                status.appendChild(spinner);
                status.appendChild(document.createTextNode(form.dataset.progress));
              });
            });
          </script>
{{template "admin-close" .}}{{end}}
